{
  "name": "restaurant-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.config.*\" \"*.json\" README.md",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\" \"*.config.*\" \"*.json\" README.md",
    "test": "npm run test:unit",
    "test:unit": "vitest run --passWithNoTests src",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:contracts": "vitest run --passWithNoTests tests/contracts",
    "test:e2e": "playwright test --pass-with-no-tests",
    "db:migrate": "prisma migrate deploy",
    "worker": "node scripts/worker-not-implemented.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "square": "46.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
