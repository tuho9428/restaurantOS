# Copy to .env.local for local development. All secrets remain unset until a later task needs them.
APP_ENV=local
SQUARE_GATEWAY_MODE=FAKE
EMAIL_DELIVERY_MODE=CAPTURE
DEMO_DATA_ENABLED=false
SQUARE_ENV=SANDBOX
LOG_LEVEL=info
MAINTENANCE_MODE=false

# NODE_ENV is set by Next.js and test runners. It is not the deployment security environment.
# Production deployments set APP_ENV=production through deployment configuration.
# Never place a real credential in this example file.
